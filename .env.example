# Sao chép tệp này thành `.env.local` và điền các giá trị thực tế của bạn.
# Không bao giờ commit `.env.local` hoặc các khóa API thật lên Git.

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (cho tính năng Trợ lý AI DSS)
VITE_GEMINI_API_KEY=your-gemini-api-key

